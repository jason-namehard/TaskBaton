<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TaskBaton.Desktop</AssemblyName>
    <Product>TaskBaton</Product>
    <FileDescription>TaskBaton Desktop</FileDescription>
    <AssemblyTitle>TaskBaton Desktop</AssemblyTitle>
    <ApplicationIcon>Assets/TaskBaton.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/TaskBaton.ico" />
    <Resource Include="Assets/Sounds/*.wav" />
    <ProjectReference Include="../TaskBaton.Core/TaskBaton.Core.csproj" />
  </ItemGroup>
</Project>
